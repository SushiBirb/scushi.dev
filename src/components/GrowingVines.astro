<!-- Fixed background container for margin vines -->
<div class="fixed inset-0 pointer-events-none z-0 overflow-hidden select-none" aria-hidden="true">
  <!-- Left Vine Track -->
  <svg
    id="vine-left"
    class="absolute top-0 bottom-0 left-0 h-full w-24 sm:w-36 lg:w-52 opacity-35 transition-opacity duration-300"
    viewBox="0 0 200 1200"
    preserveAspectRatio="none"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
  >
    <defs>
      <linearGradient id="vine-grad-left" x1="0%" y1="0%" x2="0%" y2="100%">
        <stop offset="0%" stop-color="#3f2a37" stop-opacity="0.4" />
        <stop offset="40%" stop-color="#ddbecf" stop-opacity="0.7" />
        <stop offset="100%" stop-color="#ffade4" stop-opacity="0.9" />
      </linearGradient>
      <linearGradient id="leaf-grad-left" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" stop-color="#ffade4" stop-opacity="0.6" />
        <stop offset="100%" stop-color="#f5b9a1" stop-opacity="0.2" />
      </linearGradient>
    </defs>

    <!-- Main Stem -->
    <path
      class="vine-stem"
      d="M 15 0 C 45 120, -10 260, 35 380 C 80 500, 10 640, 40 760 C 70 880, 5 1020, 30 1140 C 45 1190, 20 1200, 15 1200"
      stroke="url(#vine-grad-left)"
      stroke-width="2.5"
      stroke-linecap="round"
    />

    <!-- Secondary Twisting Vine -->
    <path
      class="vine-stem-secondary"
      d="M 25 40 C -15 160, 50 280, 10 420 C -20 540, 55 680, 20 820 C -10 940, 45 1060, 20 1200"
      stroke="url(#vine-grad-left)"
      stroke-width="1.2"
      stroke-dasharray="3 3"
      stroke-linecap="round"
      opacity="0.6"
    />

    <!-- Tendril Branches -->
    <path
      class="vine-branch"
      data-trigger="0.15"
      d="M 20 190 C 65 195, 95 170, 120 185 C 135 195, 125 215, 105 210"
      stroke="url(#vine-grad-left)"
      stroke-width="1.5"
      stroke-linecap="round"
    />
    <path
      class="vine-branch"
      data-trigger="0.32"
      d="M 28 390 C 80 395, 120 375, 145 405 C 160 420, 135 440, 115 425"
      stroke="url(#vine-grad-left)"
      stroke-width="1.5"
      stroke-linecap="round"
    />
    <path
      class="vine-branch"
      data-trigger="0.55"
      d="M 25 650 C 75 640, 110 670, 150 655 C 170 645, 160 620, 130 630"
      stroke="url(#vine-grad-left)"
      stroke-width="1.5"
      stroke-linecap="round"
    />
    <path
      class="vine-branch"
      data-trigger="0.75"
      d="M 22 910 C 85 915, 125 890, 160 920 C 175 935, 145 955, 120 940"
      stroke="url(#vine-grad-left)"
      stroke-width="1.5"
      stroke-linecap="round"
    />

    <!-- Leaves (Revealed as vine grows) -->
    <g class="vine-leaf" data-trigger="0.12">
      <path d="M 25 150 C 50 140, 60 160, 30 168 C 22 165, 20 155, 25 150 Z" fill="url(#leaf-grad-left)" stroke="#ffade4" stroke-width="0.7" />
    </g>
    <g class="vine-leaf" data-trigger="0.22">
      <path d="M 120 185 C 145 175, 155 195, 125 203 C 117 200, 115 190, 120 185 Z" fill="url(#leaf-grad-left)" stroke="#ffade4" stroke-width="0.7" />
    </g>
    <g class="vine-leaf" data-trigger="0.35">
      <path d="M 40 430 C 70 420, 80 445, 45 450 C 35 448, 35 435, 40 430 Z" fill="url(#leaf-grad-left)" stroke="#ffade4" stroke-width="0.7" />
    </g>
    <g class="vine-leaf" data-trigger="0.48">
      <path d="M 18 580 C -5 570, -10 595, 15 600 C 22 598, 22 585, 18 580 Z" fill="url(#leaf-grad-left)" stroke="#ffade4" stroke-width="0.7" />
    </g>
    <g class="vine-leaf" data-trigger="0.62">
      <path d="M 150 655 C 175 645, 185 665, 155 673 C 147 670, 145 660, 150 655 Z" fill="url(#leaf-grad-left)" stroke="#ffade4" stroke-width="0.7" />
    </g>
    <g class="vine-leaf" data-trigger="0.80">
      <path d="M 160 920 C 190 910, 195 935, 165 940 C 155 938, 155 925, 160 920 Z" fill="url(#leaf-grad-left)" stroke="#ffade4" stroke-width="0.7" />
    </g>
    <g class="vine-leaf" data-trigger="0.92">
      <path d="M 32 1100 C 65 1090, 75 1115, 38 1120 C 28 1118, 28 1105, 32 1100 Z" fill="url(#leaf-grad-left)" stroke="#ffade4" stroke-width="0.7" />
    </g>
  </svg>

  <!-- Right Vine Track (Mirrored with organic variations) -->
  <svg
    id="vine-right"
    class="absolute top-0 bottom-0 right-0 h-full w-24 sm:w-36 lg:w-52 opacity-35 transition-opacity duration-300 transform -scale-x-100"
    viewBox="0 0 200 1200"
    preserveAspectRatio="none"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
  >
    <defs>
      <linearGradient id="vine-grad-right" x1="0%" y1="0%" x2="0%" y2="100%">
        <stop offset="0%" stop-color="#3f2a37" stop-opacity="0.4" />
        <stop offset="45%" stop-color="#ddbecf" stop-opacity="0.7" />
        <stop offset="100%" stop-color="#ffade4" stop-opacity="0.9" />
      </linearGradient>
      <linearGradient id="leaf-grad-right" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" stop-color="#ffade4" stop-opacity="0.6" />
        <stop offset="100%" stop-color="#f5b9a1" stop-opacity="0.2" />
      </linearGradient>
    </defs>

    <!-- Main Stem -->
    <path
      class="vine-stem"
      d="M 20 0 C -10 140, 50 270, 15 410 C -25 530, 45 660, 10 790 C -20 920, 50 1040, 20 1160 C 15 1190, 22 1200, 18 1200"
      stroke="url(#vine-grad-right)"
      stroke-width="2.5"
      stroke-linecap="round"
    />

    <!-- Secondary Twisting Vine -->
    <path
      class="vine-stem-secondary"
      d="M 10 50 C 45 170, -15 300, 30 430 C 65 560, -5 690, 35 830 C 70 960, 5 1080, 25 1200"
      stroke="url(#vine-grad-right)"
      stroke-width="1.2"
      stroke-dasharray="3 3"
      stroke-linecap="round"
      opacity="0.6"
    />

    <!-- Tendril Branches -->
    <path
      class="vine-branch"
      data-trigger="0.20"
      d="M 18 240 C 70 245, 105 220, 135 240 C 150 250, 135 270, 115 260"
      stroke="url(#vine-grad-right)"
      stroke-width="1.5"
      stroke-linecap="round"
    />
    <path
      class="vine-branch"
      data-trigger="0.42"
      d="M 14 510 C 65 500, 110 535, 145 520 C 160 510, 145 490, 120 500"
      stroke="url(#vine-grad-right)"
      stroke-width="1.5"
      stroke-linecap="round"
    />
    <path
      class="vine-branch"
      data-trigger="0.68"
      d="M 12 810 C 75 815, 115 790, 150 820 C 165 835, 135 855, 110 840"
      stroke="url(#vine-grad-right)"
      stroke-width="1.5"
      stroke-linecap="round"
    />

    <!-- Leaves -->
    <g class="vine-leaf" data-trigger="0.18">
      <path d="M 22 210 C 50 200, 60 220, 28 228 C 20 225, 18 215, 22 210 Z" fill="url(#leaf-grad-right)" stroke="#ffade4" stroke-width="0.7" />
    </g>
    <g class="vine-leaf" data-trigger="0.28">
      <path d="M 135 240 C 165 230, 170 255, 138 260 C 128 258, 128 245, 135 240 Z" fill="url(#leaf-grad-right)" stroke="#ffade4" stroke-width="0.7" />
    </g>
    <g class="vine-leaf" data-trigger="0.45">
      <path d="M 145 520 C 175 510, 180 535, 148 540 C 138 538, 138 525, 145 520 Z" fill="url(#leaf-grad-right)" stroke="#ffade4" stroke-width="0.7" />
    </g>
    <g class="vine-leaf" data-trigger="0.72">
      <path d="M 150 820 C 180 810, 185 835, 155 840 C 145 838, 145 825, 150 820 Z" fill="url(#leaf-grad-right)" stroke="#ffade4" stroke-width="0.7" />
    </g>
  </svg>
</div>

<script>
  // Progressive scroll-growth engine for botanical vines
  function initVineGrowth() {
    const stems = document.querySelectorAll<SVGPathElement>('.vine-stem, .vine-stem-secondary, .vine-branch');
    const leaves = document.querySelectorAll<SVGGElement>('.vine-leaf');

    // Precalculate and configure path lengths
    stems.forEach((stem) => {
      const length = stem.getTotalLength();
      stem.style.strokeDasharray = `${length}`;
      stem.style.strokeDashoffset = `${length}`;
      stem.dataset.length = `${length}`;
    });

    // Initialize leaves as hidden
    leaves.forEach((leaf) => {
      leaf.style.opacity = '0';
      leaf.style.transform = 'scale(0.3)';
      leaf.style.transformOrigin = 'center';
      leaf.style.transition = 'opacity 0.4s ease-out, transform 0.5s cubic-bezier(0.34, 1.56, 0.64, 1)';
    });

    let ticking = false;

    function onScroll() {
      if (!ticking) {
        requestAnimationFrame(() => {
          const docHeight = document.documentElement.scrollHeight - window.innerHeight;
          const scrollPercent = docHeight > 0 ? Math.min(Math.max(window.scrollY / docHeight, 0), 1) : 1;

          // Main and secondary stems grow proportional to scroll
          stems.forEach((stem) => {
            const length = parseFloat(stem.dataset.length || '1000');
            const trigger = parseFloat(stem.dataset.trigger || '0');

            if (trigger > 0) {
              // Side branch: grows only after vine reaches trigger depth
              if (scrollPercent >= trigger) {
                const branchProgress = Math.min((scrollPercent - trigger) * 4, 1);
                stem.style.strokeDashoffset = `${length * (1 - branchProgress)}`;
              } else {
                stem.style.strokeDashoffset = `${length}`;
              }
            } else {
              // Main trunk: grows with overall scroll with a slight lead
              const trunkProgress = Math.min(scrollPercent * 1.15 + 0.05, 1);
              stem.style.strokeDashoffset = `${length * (1 - trunkProgress)}`;
            }
          });

          // Unfurl leaves when scroll depth crosses trigger points
          leaves.forEach((leaf) => {
            const trigger = parseFloat(leaf.dataset.trigger || '0');
            if (scrollPercent >= trigger) {
              leaf.style.opacity = '1';
              leaf.style.transform = 'scale(1)';
            } else {
              leaf.style.opacity = '0';
              leaf.style.transform = 'scale(0.3)';
            }
          });

          ticking = false;
        });
        ticking = true;
      }
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    // Trigger initial calculation
    onScroll();
  }

  // Initialize on page load and client-side page changes
  initVineGrowth();
  document.addEventListener('astro:page-load', initVineGrowth);
</script>

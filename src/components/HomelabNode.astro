---
import { Server, ArrowUpRight } from 'lucide-astro';

const services = [
  { name: 'Edge Ingress Gateway', tier: 'zero-trust', role: 'Cloudflare Tunnel & Automated TLS Ingress' },
  { name: 'Encrypted Transit Node', tier: 'wireguard', role: 'Cross-site Tailscale mesh router & exit gateway' },
  { name: 'Recursive DNS Sinkhole', tier: 'privacy', role: 'AdGuard Home with HaGeZi Pro threat protection' },
  { name: 'Distributed Storage Sync', tier: 'replication', role: 'Continuous bidirectional CouchDB vault sync' },
];
---

<div class="rounded-xl border border-neutral-800/80 bg-neutral-900/20 p-5 mt-4 space-y-4">
  <div class="flex items-center justify-between">
    <div class="flex items-center gap-2.5">
      <Server class="w-5 h-5 text-accent" />
      <div>
        <h3 class="text-base font-semibold text-white">scushi-server (Proxmox VE)</h3>
        <p class="text-xs text-neutral-400">virtualized homelab cluster powering scushi.dev</p>
      </div>
    </div>
    <div class="flex items-center gap-1.5 text-xs text-accent font-mono bg-accent/10 border border-accent/25 px-2.5 py-1 rounded-full">
      <span class="inline-block w-1.5 h-1.5 rounded-full bg-accent animate-pulse"></span>
      100% nominal
    </div>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5 pt-2">
    {services.map((svc) => (
      <div class="rounded-lg bg-neutral-950/60 border border-neutral-800/60 p-3 hover:border-neutral-700/80 transition-colors">
        <div class="flex items-center justify-between text-xs mb-1">
          <span class="text-neutral-200 font-medium">{svc.name}</span>
          <span class="text-[10px] text-accent font-mono">{svc.tier}</span>
        </div>
        <p class="text-[11px] text-neutral-400">{svc.role}</p>
      </div>
    ))}
  </div>

  <div class="flex items-center justify-between pt-2 border-t border-neutral-800/60 text-xs text-neutral-400 font-mono">
    <span>arch linux · hyprland · proxmox</span>
    <a href="/systems" class="inline-flex items-center gap-1 text-accent hover:underline group">
      view full architecture
      <ArrowUpRight class="w-3.5 h-3.5 transition-transform duration-200 group-hover:translate-x-0.5 group-hover:-translate-y-0.5" />
    </a>
  </div>
</div>

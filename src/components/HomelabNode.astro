---
import { Server, Shield, Network, Database, Cpu } from 'lucide-astro';

const services = [
  { name: 'Caddy Edge & Tunnel', lxc: 'LXC 104', role: 'Cloudflare Zero-Trust Ingress & TLS', status: 'online' },
  { name: 'Tailscale Router', lxc: 'LXC 100', role: 'Subnet 192.168.0.0/22 & WireGuard', status: 'online' },
  { name: 'AdGuard Home', lxc: 'LXC 101', role: 'Local Network DNS & Sinkhole', status: 'online' },
  { name: 'CouchDB LiveSync', lxc: 'LXC 106', role: 'Distributed Vault Replication', status: 'online' },
];
---

<div class="rounded-xl border border-neutral-800/80 bg-neutral-900/20 p-5 mt-4 space-y-4">
  <div class="flex items-center justify-between">
    <div class="flex items-center gap-2.5">
      <Server class="w-5 h-5 text-accent accent-glow-subtle" />
      <div>
        <h3 class="text-base font-semibold text-white">scushi-server (Proxmox VE)</h3>
        <p class="text-xs text-neutral-400">self-hosted cluster powering scushi.dev</p>
      </div>
    </div>
    <div class="flex items-center gap-1.5 text-xs text-accent font-mono bg-accent/10 border border-accent/25 px-2.5 py-1 rounded-full">
      <span class="inline-block w-1.5 h-1.5 rounded-full bg-accent animate-pulse"></span>
      100% uptime
    </div>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5 pt-2">
    {services.map((svc) => (
      <div class="rounded-lg bg-neutral-950/60 border border-neutral-800/60 p-3 hover:border-neutral-700/80 transition-colors">
        <div class="flex items-center justify-between text-xs mb-1">
          <span class="text-neutral-200 font-medium">{svc.name}</span>
          <span class="text-[10px] text-accent font-mono">{svc.lxc}</span>
        </div>
        <p class="text-[11px] text-neutral-400">{svc.role}</p>
      </div>
    ))}
  </div>

  <div class="flex items-center justify-between pt-2 border-t border-neutral-800/60 text-xs text-neutral-400 font-mono">
    <span>arch linux · hyprland · proxmox</span>
    <span class="text-neutral-600">wan via cloudflared</span>
  </div>
</div>

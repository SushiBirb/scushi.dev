---
---

<canvas
  id="ascii-spotlight-canvas"
  class="fixed inset-0 pointer-events-none z-0 w-full h-full select-none"
  aria-hidden="true"
></canvas>

<script>
  function initAsciiSpotlight() {
    const canvas = document.getElementById('ascii-spotlight-canvas') as HTMLCanvasElement;
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    let width = 0;
    let height = 0;
    let dpr = 1;

    // Grid sizing
    const charW = 14;
    const charH = 18;
    let cols = 0;
    let rows = 0;

    // Spotlight flashlight radius around cursor
    const spotlightRadius = 180;

    // 3 Palettes for the Continuous Descent Gradient
    // Top: Airy, celestial, sparse stars and gentle glyphs
    const heavenGlyphs = ['·', '°', '*', '✦', '~', '^', '+', ':', '·'];
    // Mid: Structural logic gates, matrix conduits, binary brackets
    const matrixGlyphs = ['|', '/', '\\', '[', ']', '#', '_', '=', '0', '1', ':'];
    // Bottom: Dense subterranean roots, stalagmites, cracked stone, embers
    const abyssGlyphs = ['v', '▼', ';', '%', '#', '&', '§', 'x', '/\\', 'v', ','];

    let mouseX = -9999;
    let mouseY = -9999;
    let isMouseInWindow = false;

    function resize() {
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      width = window.innerWidth;
      height = window.innerHeight;
      canvas.width = width * dpr;
      canvas.height = height * dpr;
      ctx?.scale(dpr, dpr);

      cols = Math.ceil(width / charW) + 1;
      rows = Math.ceil(height / charH) + 1;
    }

    // Deterministic pseudo-random noise for grid coordinates
    function pseudoNoise(x: number, y: number): number {
      const n = Math.sin(x * 12.9898 + y * 78.233) * 43758.5453;
      return n - Math.floor(n);
    }

    let animationFrameId: number;

    function render(time: number) {
      ctx!.clearRect(0, 0, width, height);

      // Only draw if mouse is inside the viewport
      if (isMouseInWindow && mouseX > -100 && mouseX < width + 100 && mouseY > -100 && mouseY < height + 100) {
        ctx!.font = '11px "JetBrains Mono", monospace';
        ctx!.textAlign = 'center';
        ctx!.textBaseline = 'middle';

        // Calculate bounding box around mouse in grid coordinates
        const minCol = Math.max(0, Math.floor((mouseX - spotlightRadius) / charW));
        const maxCol = Math.min(cols, Math.ceil((mouseX + spotlightRadius) / charW));
        const minRow = Math.max(0, Math.floor((mouseY - spotlightRadius) / charH));
        const maxRow = Math.min(rows, Math.ceil((mouseY + spotlightRadius) / charH));

        // Fixed world grid row tracking to ensure glyph positions stay stable during scroll
        const scrollRowOffset = Math.floor(window.scrollY / charH);
        const totalDocHeight = Math.max(document.documentElement.scrollHeight, 1200);

        for (let c = minCol; c <= maxCol; c++) {
          const x = c * charW;
          const dx = mouseX - x;

          for (let r = minRow; r <= maxRow; r++) {
            const y = r * charH;
            const dy = mouseY - y;
            const dist = Math.sqrt(dx * dx + dy * dy);

            // Outside the cursor spotlight radius -> 100% invisible
            if (dist >= spotlightRadius) continue;

            // Stable world coordinates
            const worldRow = r + scrollRowOffset;
            const worldY = worldRow * charH;

            // Normalized descent depth (0.0 = Top/Heaven -> 1.0 = Bottom/Abyss)
            const depth = Math.min(Math.max(worldY / totalDocHeight, 0), 1);

            const rand = pseudoNoise(c, worldRow);
            const rand2 = pseudoNoise(c + 47, worldRow + 89);
            const rand3 = pseudoNoise(c + 91, worldRow + 13);

            // Continuous Density Gradient:
            // Top: Threshold ~0.86 (only 14% of cells filled, wide gaps, very spacey)
            // Bottom: Threshold ~0.42 (58% of cells filled, heavily clustered, dense)
            const densityThreshold = 0.86 - Math.pow(depth, 0.8) * 0.44;
            if (rand < densityThreshold) continue;

            // Continuous Probabilistic Blend between Character Stages:
            // Continuous weights for smooth crossfade with zero hard steps
            let wHeaven = Math.max(0, 1 - depth * 2.2); // Dominates 0.0 -> 0.45
            let wMatrix = Math.max(0, 1 - Math.abs(depth - 0.5) * 2.2); // Dominates 0.25 -> 0.75
            let wAbyss = Math.max(0, (depth - 0.45) * 2.0); // Dominates 0.55 -> 1.0

            const totalW = wHeaven + wMatrix + wAbyss || 1;
            const normHeaven = wHeaven / totalW;
            const normMatrix = wMatrix / totalW;

            let char = '·';
            let color = '#ffade4';

            if (rand3 < normHeaven) {
              // Sampled from Celestial palette
              char = heavenGlyphs[Math.floor(rand2 * heavenGlyphs.length)];
              color = rand2 > 0.5 ? '#ffd7ee' : '#ffade4'; // Airy ethereal highlight
            } else if (rand3 < normHeaven + normMatrix) {
              // Sampled from Matrix / Structural palette
              char = matrixGlyphs[Math.floor(rand2 * matrixGlyphs.length)];
              color = rand2 > 0.6 ? '#ffade4' : '#ddbecf'; // Core system pink/steel
            } else {
              // Sampled from Abyss / Infernal palette
              char = abyssGlyphs[Math.floor(rand2 * abyssGlyphs.length)];
              color = rand2 > 0.6 ? '#f5b9a1' : '#ffade4'; // Warm amber/ember tones
            }

            // Exponential spotlight falloff: bright in center, soft fade at perimeter
            const intensity = Math.pow(1 - dist / spotlightRadius, 1.4);
            // Slightly deeper opacity at lower depths to complement density
            const baseMaxAlpha = 0.55 + depth * 0.2;
            const alpha = intensity * baseMaxAlpha;

            if (alpha <= 0.02) continue;

            ctx!.fillStyle = color;
            ctx!.globalAlpha = alpha;
            ctx!.fillText(char, x, y);
          }
        }
      }

      ctx!.globalAlpha = 1;
      animationFrameId = requestAnimationFrame(render);
    }

    function onMouseMove(e: MouseEvent) {
      mouseX = e.clientX;
      mouseY = e.clientY;
      isMouseInWindow = true;
    }

    function onMouseLeave() {
      isMouseInWindow = false;
      mouseX = -9999;
      mouseY = -9999;
    }

    window.addEventListener('resize', resize);
    window.addEventListener('mousemove', onMouseMove, { passive: true });
    document.addEventListener('mouseleave', onMouseLeave);

    resize();
    animationFrameId = requestAnimationFrame(render);

    return () => {
      window.removeEventListener('resize', resize);
      window.removeEventListener('mousemove', onMouseMove);
      document.removeEventListener('mouseleave', onMouseLeave);
      cancelAnimationFrame(animationFrameId);
    };
  }

  initAsciiSpotlight();
  document.addEventListener('astro:page-load', initAsciiSpotlight);
</script>

---
interface Props {
  text: string;
  as?: 'h1' | 'h2' | 'span';
  class?: string;
}

const { text, as: Tag = 'span', class: className = '' } = Astro.props;
---

<Tag class={`scramble-text inline-block cursor-default select-none ${className}`} data-value={text}>
  {text}
</Tag>

<script>
  const chars = '!<>-_\\/[]{}—=+*^?#________0101';

  function scramble(element: HTMLElement) {
    const final = element.dataset.value || element.innerText;
    let iteration = 0;
    const interval = setInterval(() => {
      element.innerText = final
        .split('')
        .map((letter, index) => {
          if (index < iteration) {
            return final[index];
          }
          if (letter === ' ') return ' ';
          return chars[Math.floor(Math.random() * chars.length)];
        })
        .join('');

      if (iteration >= final.length) {
        clearInterval(interval);
      }
      iteration += 1 / 3;
    }, 25);
  }

  // Auto-scramble on page mount and client-side page load
  function initScramble() {
    document.querySelectorAll<HTMLElement>('.scramble-text').forEach((el) => {
      scramble(el);
      if (el.dataset.scrambleAttached !== 'true') {
        el.dataset.scrambleAttached = 'true';
        el.addEventListener('mouseenter', () => scramble(el));
      }
    });
  }

  initScramble();
  document.addEventListener('astro:page-load', initScramble);
</script>

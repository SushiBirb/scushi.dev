---
interface Props {
  email?: string;
  github?: string;
  linkedin?: string;
}

const {
  email = "jmattingly@proitserv.com",
  github = "https://github.com/SushiBirb",
  linkedin = "https://linkedin.com/in/joshua-mattingly-39145721b"
} = Astro.props;
---

<section id="elsewhere" class="mt-14 pt-10 pb-16 border-t border-neutral-800/80 animate-fade-in-up">
  <h2 class="text-2xl font-semibold mb-6 flex items-center text-white">
    <span class="text-accent mr-2 font-bold select-none">*</span> elsewhere
  </h2>

  <div class="flex flex-wrap items-center gap-x-6 gap-y-3 text-sm">
    <!-- Interactive Copy Email Button -->
    <button
      id="copy-email-btn"
      data-email={email}
      class="group inline-flex items-center gap-1.5 text-neutral-400 hover:text-accent transition-colors duration-200 cursor-pointer font-mono"
    >
      <span>email</span>
      <span id="copy-tooltip" class="text-[11px] text-accent opacity-0 transition-opacity duration-200">
        [copied!]
      </span>
    </button>

    <a
      href={linkedin}
      target="_blank"
      rel="noopener noreferrer"
      class="text-neutral-400 hover:text-accent transition-colors duration-200"
    >
      linkedin
    </a>

    <a
      href={github}
      target="_blank"
      rel="noopener noreferrer"
      class="text-neutral-400 hover:text-accent transition-colors duration-200"
    >
      github
    </a>

    <a
      href="https://github.com/SushiBirb/HyprWpE"
      target="_blank"
      rel="noopener noreferrer"
      class="text-neutral-400 hover:text-accent transition-colors duration-200"
    >
      dotfiles
    </a>
  </div>

  <div class="mt-8 pt-6 border-t border-neutral-800/50 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 text-xs text-neutral-400">
    <div class="flex items-center gap-2">
      <span class="px-2 py-0.5 rounded bg-accent/10 border border-accent/25 text-accent font-mono text-[11px]">
        CompTIA Security+
      </span>
      <span class="px-2 py-0.5 rounded bg-accent/10 border border-accent/25 text-accent font-mono text-[11px]">
        CompTIA A+
      </span>
    </div>
    <span class="text-neutral-400 font-mono">
      Joshua Mattingly · © {new Date().getFullYear()}
    </span>
  </div>
</section>

<script>
  const copyBtn = document.getElementById('copy-email-btn');
  const tooltip = document.getElementById('copy-tooltip');

  if (copyBtn && tooltip) {
    copyBtn.addEventListener('click', async () => {
      const email = copyBtn.dataset.email || 'jmattingly@proitserv.com';
      try {
        await navigator.clipboard.writeText(email);
        tooltip.style.opacity = '1';
        setTimeout(() => {
          tooltip.style.opacity = '0';
        }, 1800);
      } catch (err) {
        console.error('Failed to copy email:', err);
      }
    });
  }
</script>

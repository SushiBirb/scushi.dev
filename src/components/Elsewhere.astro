---
import { ArrowUpRight, Copy, Check } from 'lucide-astro';

interface Props {
  email?: string;
  github?: string;
  linkedin?: string;
}

const {
  email = "jmattingly@proitserv.com",
  github = "https://github.com/SushiBirb",
  linkedin = "https://linkedin.com/in/joshua-mattingly-39145721b"
} = Astro.props;

const mailtoUrl = `mailto:${email}?subject=Hello%20from%20scushi.dev`;
---

<section id="elsewhere" class="mt-14 pt-10 pb-16 border-t border-neutral-800/80 animate-fade-in-up">
  <h2 class="text-2xl font-semibold mb-6 flex items-center text-white">
    <span class="text-accent mr-2 font-bold select-none">*</span> elsewhere
  </h2>

  <div class="flex flex-wrap items-center gap-x-6 gap-y-3 text-sm">
    <!-- Native Mailto Launch Link (Opens default mail client like Outlook) -->
    <a
      href={mailtoUrl}
      class="text-neutral-400 hover:text-accent transition-colors duration-200 inline-flex items-center gap-1 font-mono"
    >
      email
      <ArrowUpRight class="w-3.5 h-3.5 opacity-60" />
    </a>

    <!-- Copy Email fallback -->
    <button
      id="copy-email-btn"
      data-email={email}
      title="Copy email to clipboard"
      class="text-xs text-neutral-500 hover:text-neutral-300 font-mono transition-colors cursor-pointer"
    >
      [<span id="copy-label">copy</span>]
    </button>

    <a
      href={linkedin}
      target="_blank"
      rel="noopener noreferrer"
      class="text-neutral-400 hover:text-accent transition-colors duration-200 inline-flex items-center gap-1"
    >
      linkedin
      <ArrowUpRight class="w-3.5 h-3.5 opacity-60" />
    </a>

    <a
      href={github}
      target="_blank"
      rel="noopener noreferrer"
      class="text-neutral-400 hover:text-accent transition-colors duration-200 inline-flex items-center gap-1"
    >
      github
      <ArrowUpRight class="w-3.5 h-3.5 opacity-60" />
    </a>

    <a
      href="https://github.com/SushiBirb/scushi-ryoku"
      target="_blank"
      rel="noopener noreferrer"
      class="text-neutral-400 hover:text-accent transition-colors duration-200 inline-flex items-center gap-1"
    >
      dotfiles
      <ArrowUpRight class="w-3.5 h-3.5 opacity-60" />
    </a>
  </div>

  <!-- Verified Certifications Footer Bar with Official CompTIA Links -->
  <div class="mt-8 pt-6 border-t border-neutral-800/50 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 text-xs text-neutral-400">
    <div class="flex flex-wrap items-center gap-2">
      <a
        href="https://cp.certmetrics.com/CompTIA/en/public/verify/credential/7b38561065474ce1ac4b63ba1ea10c1c"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1 px-2.5 py-1 rounded bg-accent/10 border border-accent/25 text-accent font-mono text-[11px] hover:border-accent hover:bg-accent/15 transition-all"
        title="Verify official CompTIA Security+ Credential"
      >
        <span>CompTIA Security+ [verified]</span>
        <ArrowUpRight class="w-3 h-3" />
      </a>

      <a
        href="https://cp.certmetrics.com/CompTIA/en/public/verify/credential/SB49Z15QFN411V33"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1 px-2.5 py-1 rounded bg-accent/10 border border-accent/25 text-accent font-mono text-[11px] hover:border-accent hover:bg-accent/15 transition-all"
        title="Verify official CompTIA A+ Credential"
      >
        <span>CompTIA A+ [verified]</span>
        <ArrowUpRight class="w-3 h-3" />
      </a>
    </div>

    <span class="text-neutral-500 font-mono">
      Joshua Mattingly · © {new Date().getFullYear()}
    </span>
  </div>

  <!-- Morrowind Lore Easter Egg -->
  <div class="mt-12 pt-8 border-t border-neutral-800/40 text-center select-none">
    <p class="text-xs text-neutral-500 font-mono italic tracking-wide">
      "Welcome, Moon-and-Star, to this place where destiny is made."
    </p>
    <span class="text-[10px] text-neutral-600 font-mono uppercase tracking-widest block mt-1">
      Dagoth Ur · Red Mountain
    </span>
  </div>
</section>

<script>
  function setupCopyEmail() {
    const copyBtn = document.getElementById('copy-email-btn');
    const copyLabel = document.getElementById('copy-label');

    if (copyBtn && copyLabel) {
      if (copyBtn.dataset.listenerAttached === 'true') return;
      copyBtn.dataset.listenerAttached = 'true';

      copyBtn.addEventListener('click', async () => {
        const email = copyBtn.dataset.email || 'jmattingly@proitserv.com';
        try {
          await navigator.clipboard.writeText(email);
          copyLabel.innerText = 'copied!';
          copyLabel.classList.add('text-accent');
          setTimeout(() => {
            copyLabel.innerText = 'copy';
            copyLabel.classList.remove('text-accent');
          }, 1800);
        } catch (err) {
          console.error('Failed to copy email:', err);
        }
      });
    }
  }

  setupCopyEmail();
  document.addEventListener('astro:page-load', setupCopyEmail);
</script>

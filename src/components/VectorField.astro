---
---

<canvas
  id="vector-field-canvas"
  class="fixed inset-0 pointer-events-none z-0 w-full h-full select-none"
  aria-hidden="true"
></canvas>

<script>
  function initVectorField() {
    const canvas = document.getElementById('vector-field-canvas') as HTMLCanvasElement;
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    let width = 0;
    let height = 0;
    let dpr = 1;

    // Grid configuration
    const step = 34; // Distance between vector nodes
    const needleLen = 14; // Length of directional needle

    interface VectorNode {
      x: number;
      y: number;
      angle: number;
    }

    let nodes: VectorNode[] = [];
    let cols = 0;
    let rows = 0;

    let mouseX = -9999;
    let mouseY = -9999;
    let hasMouseMoved = false;

    function resize() {
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      width = window.innerWidth;
      height = window.innerHeight;
      canvas.width = width * dpr;
      canvas.height = height * dpr;
      ctx?.scale(dpr, dpr);

      cols = Math.ceil(width / step) + 1;
      rows = Math.ceil(height / step) + 1;

      nodes = [];
      for (let r = 0; r < rows; r++) {
        for (let c = 0; c < cols; c++) {
          nodes.push({
            x: c * step,
            y: r * step,
            angle: 0,
          });
        }
      }
    }

    // Shortest angular difference between two radians
    function normalizeAngleDiff(target: number, current: number): number {
      let diff = target - current;
      while (diff < -Math.PI) diff += Math.PI * 2;
      while (diff > Math.PI) diff -= Math.PI * 2;
      return diff;
    }

    let animationFrameId: number;

    function render(time: number) {
      ctx!.clearRect(0, 0, width, height);

      const centerX = width / 2;
      const contentHalfWidth = 380; // Reading column width mask (~760px)

      // Idle ambient motion if user hasn't moved mouse yet
      const t = time * 0.001;
      const ambientTargetX = width / 2 + Math.cos(t * 0.8) * (width * 0.25);
      const ambientTargetY = height / 2 + Math.sin(t * 0.6) * (height * 0.2);

      const activeMouseX = hasMouseMoved ? mouseX : ambientTargetX;
      const activeMouseY = hasMouseMoved ? mouseY : ambientTargetY;

      for (let i = 0; i < nodes.length; i++) {
        const node = nodes[i];

        const dx = activeMouseX - node.x;
        const dy = activeMouseY - node.y;
        const distToMouse = Math.sqrt(dx * dx + dy * dy);

        // Target angle points directly toward the cursor
        const targetAngle = Math.atan2(dy, dx);

        // Smoothly interpolate angle with inertia
        const angleDiff = normalizeAngleDiff(targetAngle, node.angle);
        node.angle += angleDiff * 0.08;

        // Distance from center reading column for readability masking
        const distFromCenter = Math.abs(node.x - centerX);
        let centerMask = 1;
        if (distFromCenter < contentHalfWidth) {
          centerMask = 0.25; // Keep center column very faint
        } else {
          centerMask = Math.min(0.4 + (distFromCenter - contentHalfWidth) / 200, 1.0);
        }

        // Proximity glow & opacity near the mouse
        const mouseProximity = Math.max(0, 1 - distToMouse / 380); // 0 to 1 within 380px radius
        const baseAlpha = 0.07 + mouseProximity * 0.35;
        const finalAlpha = Math.min(baseAlpha * centerMask, 0.45);

        if (finalAlpha <= 0.01) continue;

        // Vector needle coordinates
        const halfL = (needleLen / 2) * (0.8 + mouseProximity * 0.4);
        const cos = Math.cos(node.angle);
        const sin = Math.sin(node.angle);

        const x1 = node.x - cos * halfL;
        const y1 = node.y - sin * halfL;
        const x2 = node.x + cos * halfL;
        const y2 = node.y + sin * halfL;

        // Draw needle line
        ctx!.beginPath();
        ctx!.moveTo(x1, y1);
        ctx!.lineTo(x2, y2);

        // Color shifts from muted autumn russet to vivid orange near cursor
        if (mouseProximity > 0.4) {
          ctx!.strokeStyle = `rgba(244, 157, 92, ${finalAlpha})`; // #f49d5c highlight
          ctx!.lineWidth = 1.6;
        } else {
          ctx!.strokeStyle = `rgba(224, 122, 56, ${finalAlpha})`; // #e07a38 accent
          ctx!.lineWidth = 1.1;
        }

        ctx!.lineCap = 'round';
        ctx!.stroke();

        // Tiny tip dot on the forward-facing vector point
        if (mouseProximity > 0.15) {
          ctx!.beginPath();
          ctx!.arc(x2, y2, 1.2, 0, Math.PI * 2);
          ctx!.fillStyle = `rgba(244, 157, 92, ${finalAlpha * 1.3})`;
          ctx!.fill();
        }
      }

      animationFrameId = requestAnimationFrame(render);
    }

    function onMouseMove(e: MouseEvent) {
      mouseX = e.clientX;
      mouseY = e.clientY;
      hasMouseMoved = true;
    }

    function onMouseLeave() {
      hasMouseMoved = false;
    }

    window.addEventListener('resize', resize);
    window.addEventListener('mousemove', onMouseMove, { passive: true });
    document.addEventListener('mouseleave', onMouseLeave);

    resize();
    animationFrameId = requestAnimationFrame(render);

    return () => {
      window.removeEventListener('resize', resize);
      window.removeEventListener('mousemove', onMouseMove);
      document.removeEventListener('mouseleave', onMouseLeave);
      cancelAnimationFrame(animationFrameId);
    };
  }

  // Initialize
  initVectorField();
  document.addEventListener('astro:page-load', initVectorField);
</script>

---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import ScrambleText from '../components/ScrambleText.astro';
import ProjectCard from '../components/ProjectCard.astro';
import HomelabNode from '../components/HomelabNode.astro';
import Elsewhere from '../components/Elsewhere.astro';
import { ArrowUpRight } from 'lucide-astro';

const featuredProjects = [
  {
    title: 'HyprWpE',
    href: 'https://github.com/SushiBirb/HyprWpE',
    role: 'creator and maintainer',
    timeline: 'active',
    badge: 'wayland · shaders',
    description: 'Wallpaper Engine for the Hyprland compositor on Wayland. Plays video via mpvpaper, renders interactive web with WebKitGTK, and executes 2D/3D scenes through a native WebGL2 GLSL shader transpilation pipeline without Wine/Proton.',
    tags: ['Wayland', 'Hyprland', 'GTK4', 'WebGL2', 'GLSL', 'Python', 'Rust'],
  },
  {
    title: 'FlyAway',
    href: 'https://github.com/SushiBirb/FlyAway',
    role: 'hardened security & edge contributor',
    timeline: '1st place ky tsa',
    badge: 'security · hardware',
    description: 'Attendance verification and automated student early dismissal tracking system. Upgraded with hardened edge security, cryptographic access authorization, C++20/CPR/OpenSSL kiosk clients, and centralized multi-tier management.',
    tags: ['C++20', 'OpenSSL', 'CPR', 'ASP.NET Core', 'Cryptography', 'Embedded Kiosks'],
  },
  {
    title: 'slaytheland',
    href: 'https://github.com/SushiBirb/slaytheland',
    role: 'creator',
    timeline: 'hyprland shell',
    badge: 'qml · desktop shell',
    description: 'A complete Slay the Princess desktop shell for Hyprland written natively in Quickshell (QML). Features living companions watching from screen corners, 12 fps pencil boil shaders, dynamic parallax perspectives, Foley audio, and Ryoku architecture integration.',
    tags: ['Hyprland', 'Quickshell (QML)', 'GLSL Shaders', 'Arch Linux', 'Ryoku'],
  },
];
---

<Layout
  title="scushi · Joshua Mattingly"
  description="Security-focused IT & systems engineer, CompTIA Security+ certified, Arch Linux/Hyprland ricer, and software developer."
>
  <Navbar current="home" />

  <!-- Hero Section -->
  <header id="top" class="mb-16 space-y-4">
    <div class="flex items-center gap-2 text-xs font-mono text-accent">
      <span class="inline-block w-2 h-2 rounded-full bg-accent animate-pulse"></span>
      <span>available for security & systems engineering</span>
    </div>

    <h1 class="text-4xl sm:text-5xl font-bold tracking-tight text-white mb-2 animate-fade-in flex items-center gap-2">
      <ScrambleText text="scushi" as="span" class="text-white hover:text-accent transition-colors duration-200" />
      <span class="text-accent">.dev</span>
    </h1>

    <p class="text-sm text-neutral-400 animate-fade-in flex flex-wrap items-center gap-x-2 gap-y-1">
      <span class="text-white font-medium">Joshua Mattingly</span>
      <span class="text-neutral-600">·</span>
      <span>infosec & systems</span>
      <span class="text-neutral-600">·</span>
      <span>louisville, ky</span>
    </p>

    <p class="text-neutral-300 text-pretty max-w-[60ch] leading-relaxed pt-2 animate-fade-in-up text-sm sm:text-base">
      I'm a security-focused IT professional and CIS student at the University of Louisville with active <span class="text-white">CompTIA Security+</span> and <span class="text-white">A+</span> certifications. I spend my time engineering autonomous intrusion defense in my homelab, building custom desktop shells on Arch Linux with Hyprland shaders, and developing full-stack software.
    </p>
  </header>

  <!-- Projects Section -->
  <section class="mb-16 pt-10 border-t border-neutral-800/80 animate-fade-in-up">
    <div class="flex items-baseline justify-between mb-6">
      <h2 class="text-2xl font-semibold flex items-center text-white">
        <span class="text-accent mr-2 font-bold select-none">*</span> projects
      </h2>

      <a
        href="/projects"
        class="inline-flex items-center gap-1 text-xs sm:text-sm text-accent hover:underline group font-mono"
      >
        all projects
        <ArrowUpRight class="w-4 h-4 transition-transform duration-200 group-hover:translate-x-1 group-hover:-translate-y-1" />
      </a>
    </div>

    <div class="space-y-4">
      {featuredProjects.map((project) => (
        <ProjectCard {...project} />
      ))}
    </div>
  </section>

  <!-- Systems & Infrastructure Section -->
  <section class="mb-16 pt-10 border-t border-neutral-800/80 animate-fade-in-up">
    <div class="flex items-baseline justify-between mb-2">
      <h2 class="text-2xl font-semibold flex items-center text-white">
        <span class="text-accent mr-2 font-bold select-none">*</span> systems & defense
      </h2>
      <a
        href="/systems"
        class="inline-flex items-center gap-1 text-xs sm:text-sm text-accent hover:underline group font-mono"
      >
        inspect architecture
        <ArrowUpRight class="w-4 h-4 transition-transform duration-200 group-hover:translate-x-1 group-hover:-translate-y-1" />
      </a>
    </div>

    <p class="text-xs text-neutral-400 mb-6 leading-relaxed">
      A virtualized multi-tier homelab running CrowdSec intrusion prevention, AdGuard DNS sinkholing, and zero-trust edge mesh routing.
    </p>

    <HomelabNode />
  </section>

  <!-- Elsewhere Footer -->
  <Elsewhere />
</Layout>

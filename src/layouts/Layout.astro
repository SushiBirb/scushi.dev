---
import '../styles/global.css';
import AsciiSpotlight from '../components/AsciiSpotlight.astro';
import VectorField from '../components/VectorField.astro';
import AsciiDescent from '../components/AsciiDescent.astro';
import GrowingVines from '../components/GrowingVines.astro';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "scushi · Joshua Mattingly",
  description = "personal portfolio, cybersecurity, homelab defense, and systems engineering projects by Joshua Mattingly (scushi)."
} = Astro.props;
---

<!doctype html>
<html lang="en" class="dark scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
    <link rel="alternate icon" href="/favicon.ico?v=2" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />

    <!-- Open Graph / Meta -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content="https://scushi.dev" />
    <meta name="theme-color" content="#e3c28d" />

    <ClientRouter />
  </head>
  <body class="min-h-screen bg-[var(--color-canvas)] text-neutral-200 font-mono antialiased selection:bg-accent selection:text-neutral-950 relative overflow-x-hidden">
    <!-- Background Fun Modes (persistent across navigation) -->
    <div id="bg-mode-spotlight" class="transition-opacity duration-300">
      <AsciiSpotlight />
    </div>

    <div id="bg-mode-vector" class="hidden transition-opacity duration-300">
      <VectorField />
    </div>

    <div id="bg-mode-matrix" class="hidden transition-opacity duration-300">
      <AsciiDescent />
    </div>

    <div id="bg-mode-vines" class="hidden transition-opacity duration-300">
      <GrowingVines />
    </div>

    <!-- Subtle, toned-down cursor spotlight (25% original diameter: 160px) -->
    <div id="pointer-spotlight" transition:persist class="pointer-events-none fixed inset-0 z-0 opacity-0 transition-opacity duration-500"></div>

    <div class="relative z-10 max-w-3xl mx-auto px-5 sm:px-6 py-10 sm:py-16">
      <slot />
    </div>

    <script>
      import { navigate } from 'astro:transitions/client';

      // Subtle cursor spotlight (toned down to 160px radius)
      function initPointerSpotlight() {
        const spotlight = document.getElementById('pointer-spotlight');
        if (spotlight && window.matchMedia('(pointer: fine)').matches) {
          window.addEventListener('mousemove', (e) => {
            spotlight.style.opacity = '1';
            spotlight.style.background = `radial-gradient(160px circle at ${e.clientX}px ${e.clientY}px, rgba(255, 173, 228, 0.06), transparent 85%)`;
          });
          window.addEventListener('mouseleave', () => {
            spotlight.style.opacity = '0';
          });
        }
      }

      initPointerSpotlight();
      document.addEventListener('astro:page-load', initPointerSpotlight);

      // Visual Fun Mode Manager (persistent across routes)
      function applyFunMode(mode: string, save = true) {
        if (mode === 'swarm') {
          triggerSwarmRebuild();
          return;
        }

        const validModes = ['spotlight', 'vector', 'matrix', 'vines'];
        const targetMode = validModes.includes(mode) ? mode : 'spotlight';

        if (save) {
          try {
            localStorage.setItem('scushi_fun_mode', targetMode);
          } catch (_) {}
        }

        validModes.forEach((m) => {
          const el = document.getElementById(`bg-mode-${m}`);
          if (el) {
            if (m === targetMode) {
              el.classList.remove('hidden');
            } else {
              el.classList.add('hidden');
            }
          }
        });

        // Toggle pointer spotlight
        const spotlight = document.getElementById('pointer-spotlight');
        if (spotlight) {
          if (targetMode === 'matrix') {
            spotlight.style.display = 'none';
          } else {
            spotlight.style.display = '';
          }
        }

        const label = document.getElementById('fun-mode-current');
        if (label) {
          label.textContent = targetMode;
        }

        document.querySelectorAll('.fun-mode-item').forEach((item) => {
          const m = (item as HTMLElement).dataset.mode;
          const check = item.querySelector('.mode-check');
          if (check) {
            if (m === targetMode) {
              check.classList.remove('hidden');
            } else {
              check.classList.add('hidden');
            }
          }
        });
      }

      (window as any).applyFunMode = applyFunMode;

      function initActiveFunMode() {
        let saved = 'spotlight';
        try {
          saved = localStorage.getItem('scushi_fun_mode') || 'spotlight';
        } catch (_) {}
        applyFunMode(saved, false);
      }

      initActiveFunMode();
      document.addEventListener('astro:page-load', initActiveFunMode);

      // Swarm Rebuild Loader & Triggers
      function triggerSwarmRebuild() {
        if ((window as any).__swarmRebuild) {
          (window as any).__swarmRebuild.toggle();
        } else {
          (window as any).__swarmAutoStart = true;
          const existing = document.getElementById('swarm-rebuild-script');
          if (!existing) {
            const script = document.createElement('script');
            script.src = '/swarm.js?v=2';
            script.id = 'swarm-rebuild-script';
            document.body.appendChild(script);
          }
        }
      }

      (window as any).triggerSwarmRebuild = triggerSwarmRebuild;

      function checkSwarmAutoLaunch() {
        const h = window.location.hostname;
        const s = window.location.search;
        const p = window.location.pathname;
        if (h.startsWith('beta.') || h.startsWith('test.') || s.includes('swarm') || p.endsWith('/swarm')) {
          triggerSwarmRebuild();
        }
      }

      checkSwarmAutoLaunch();
      document.addEventListener('astro:page-load', checkSwarmAutoLaunch);

      // Universal keyboard shortcuts: [h], [p], [s], [b]
      window.addEventListener('keydown', (e) => {
        if (['INPUT', 'TEXTAREA'].includes((e.target as HTMLElement)?.tagName)) return;
        if (e.metaKey || e.ctrlKey || e.altKey) return;

        const key = e.key.toLowerCase();
        const currentPath = window.location.pathname.replace(/\/$/, '') || '/';

        if (key === 'h') {
          e.preventDefault();
          if (currentPath === '/' || currentPath === '') {
            window.scrollTo({ top: 0, behavior: 'smooth' });
          } else {
            navigate('/');
          }
        } else if (key === 'p') {
          e.preventDefault();
          if (currentPath === '/projects') {
            window.scrollTo({ top: 0, behavior: 'smooth' });
          } else {
            navigate('/projects/');
          }
        } else if (key === 's') {
          e.preventDefault();
          if (currentPath === '/systems') {
            window.scrollTo({ top: 0, behavior: 'smooth' });
          } else {
            navigate('/systems/');
          }
        } else if (key === 'b') {
          e.preventDefault();
          triggerSwarmRebuild();
        }
      });
    </script>
  </body>
</html>

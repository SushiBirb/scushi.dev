---
import '../styles/global.css';
import AsciiSpotlight from '../components/AsciiSpotlight.astro';
import VectorField from '../components/VectorField.astro';
import AsciiDescent from '../components/AsciiDescent.astro';
import GrowingVines from '../components/GrowingVines.astro';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "scushi · Joshua Mattingly",
  description = "personal portfolio, cybersecurity, homelab defense, and systems engineering projects by Joshua Mattingly (scushi)."
} = Astro.props;
---

<!doctype html>
<html lang="en" class="dark scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
    <link rel="alternate icon" href="/favicon.ico?v=2" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />

    <!-- Open Graph / Meta -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content="https://scushi.dev" />
    <meta name="theme-color" content="#e3c28d" />

    <!-- Structured data: machine-readable candidate profile (schema.org) -->
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Person',
      '@id': 'https://scushi.dev/#person',
      name: 'Joshua Mattingly',
      alternateName: 'scushi',
      url: 'https://scushi.dev/',
      description: 'Security-focused IT and systems engineer, CompTIA Security+ and A+ certified, CIS student at the University of Louisville, and operator of a production defense-in-depth home lab hosting this site.',
      jobTitle: 'IT and Systems Security Engineer',
      email: 'mailto:jmattingly@proitserv.com',
      knowsAbout: [
        'systems engineering',
        'cybersecurity',
        'network engineering',
        'Rust',
        'C++',
        'Go',
        'Python',
        'Linux',
        'reverse engineering',
        'intrusion detection',
        'Proxmox VE',
        'WireGuard',
        'Cloudflare edge networking'
      ],
      sameAs: [
        'https://github.com/SushiBirb',
        'https://linkedin.com/in/joshua-mattingly-39145721b'
      ],
      hasCredential: [
        {
          '@type': 'EducationalOccupationalCredential',
          name: 'CompTIA Security+',
          credentialStatus: 'Active',
          url: 'https://cp.certmetrics.com/CompTIA/en/public/verify/credential/7b38561065474ce1acb63ba1ea10c1c',
          recognizedBy: { '@type': 'Organization', name: 'CompTIA' }
        },
        {
          '@type': 'EducationalOccupationalCredential',
          name: 'CompTIA A+',
          credentialStatus: 'Active',
          url: 'https://cp.certmetrics.com/CompTIA/en/public/verify/credential/SB49Z15QFN411V33',
          recognizedBy: { '@type': 'Organization', name: 'CompTIA' }
        }
      ],
      award: [
        '1st Place State Champion, Enterprise Networking, FBLA',
        '1st Place State Champion, Software Development, TSA'
      ],
      affiliation: {
        '@type': 'CollegeOrUniversity',
        name: 'University of Louisville'
      }
    })} />

    <ClientRouter />
  </head>
  <body class="min-h-screen bg-[var(--color-canvas)] text-neutral-200 font-mono antialiased selection:bg-accent selection:text-neutral-950 relative overflow-x-hidden">
    <!-- Background Fun Modes (persistent across navigation) -->
    <div id="bg-mode-spotlight" class="transition-opacity duration-300">
      <AsciiSpotlight />
    </div>

    <div id="bg-mode-vector" class="hidden transition-opacity duration-300">
      <VectorField />
    </div>

    <div id="bg-mode-matrix" class="hidden transition-opacity duration-300">
      <AsciiDescent />
    </div>

    <div id="bg-mode-vines" class="hidden transition-opacity duration-300">
      <GrowingVines />
    </div>

    <!-- Subtle, toned-down cursor spotlight (25% original diameter: 160px) -->
    <div id="pointer-spotlight" transition:persist class="pointer-events-none fixed inset-0 z-0 opacity-0 transition-opacity duration-500"></div>

    <div class="relative z-10 max-w-3xl mx-auto px-5 sm:px-6 py-10 sm:py-16">
      <slot />
    </div>

    <script>
      import { navigate } from 'astro:transitions/client';

      // Subtle cursor spotlight (toned down to 160px radius)
      function initPointerSpotlight() {
        const spotlight = document.getElementById('pointer-spotlight');
        if (spotlight && window.matchMedia('(pointer: fine)').matches) {
          window.addEventListener('mousemove', (e) => {
            spotlight.style.opacity = '1';
            spotlight.style.background = `radial-gradient(160px circle at ${e.clientX}px ${e.clientY}px, rgba(255, 173, 228, 0.06), transparent 85%)`;
          });
          window.addEventListener('mouseleave', () => {
            spotlight.style.opacity = '0';
          });
        }
      }

      initPointerSpotlight();
      document.addEventListener('astro:page-load', initPointerSpotlight);

      // Visual Fun Mode & Interactive Toys Manager
      let activeToy: string | null = null;

      const TOY_CONFIGS: Record<string, { src: string; global: string }> = {
        asteroids: { src: '/toys/asteroids.js', global: '__asteroids' },
        katamari: { src: '/toys/katamari.js', global: '__katamari' },
        oneko: { src: '/toys/oneko.js', global: '__oneko' },
        crt: { src: '/toys/crt.js', global: '__crt' },
        dvd: { src: '/toys/dvd.js', global: '__dvd' },
        elevator: { src: '/toys/elevator.js', global: '__elevator' },
        ghost: { src: '/toys/ghost-cursors.js', global: '__ghostCursors' },
        webamp: { src: '/toys/webamp.js', global: '__webamp' },
      };

      function updateModeUI(targetMode: string) {
        const label = document.getElementById('fun-mode-current');
        if (label) {
          label.textContent = targetMode;
        }

        document.querySelectorAll('.fun-mode-item').forEach((item) => {
          const m = (item as HTMLElement).dataset.mode;
          const check = item.querySelector('.mode-check');
          if (check) {
            if (m === targetMode) {
              check.classList.remove('hidden');
            } else {
              check.classList.add('hidden');
            }
          }
        });
      }

      function stopActiveToy() {
        if (!activeToy) return;
        try {
          sessionStorage.removeItem('scushi_active_toy');
        } catch (_) {}
        if (activeToy === 'swarm') {
          if ((window as any).__swarmRebuild?.cleanup) {
            (window as any).__swarmRebuild.cleanup();
          }
        } else if (TOY_CONFIGS[activeToy]) {
          const g = (window as any)[TOY_CONFIGS[activeToy].global];
          if (g && typeof g.stop === 'function') {
            g.stop();
          }
        }
        activeToy = null;
      }

      function launchToy(toy: string, save = true) {
        if (toy === 'swarm') {
          triggerSwarmRebuild();
          activeToy = 'swarm';
          updateModeUI('swarm');
          return;
        }

        const config = TOY_CONFIGS[toy];
        if (!config) return;

        if (activeToy === toy) {
          const g = (window as any)[config.global];
          if (g && typeof g.isRunning === 'function' && g.isRunning()) {
            stopActiveToy();
            initActiveFunMode();
            return;
          }
        }

        stopActiveToy();

        if (save) {
          try {
            sessionStorage.setItem('scushi_active_toy', toy);
          } catch (_) {}
        }

        const existingGlobal = (window as any)[config.global];
        if (existingGlobal && typeof existingGlobal.start === 'function') {
          existingGlobal.start();
          activeToy = toy;
          updateModeUI(toy);
        } else {
          const script = document.createElement('script');
          script.src = `${config.src}?v=3`;
          script.onload = () => {
            activeToy = toy;
            updateModeUI(toy);
          };
          document.body.appendChild(script);
        }
      }

      function applyFunMode(mode: string, save = true) {
        if (mode === 'swarm' || TOY_CONFIGS[mode]) {
          launchToy(mode, save);
          return;
        }

        stopActiveToy();

        const validModes = ['spotlight', 'vector', 'matrix', 'vines'];
        const targetMode = validModes.includes(mode) ? mode : 'spotlight';

        if (save) {
          try {
            localStorage.setItem('scushi_fun_mode', targetMode);
            sessionStorage.removeItem('scushi_active_toy');
          } catch (_) {}
        }

        validModes.forEach((m) => {
          const el = document.getElementById(`bg-mode-${m}`);
          if (el) {
            if (m === targetMode) {
              el.classList.remove('hidden');
            } else {
              el.classList.add('hidden');
            }
          }
        });

        // Toggle pointer spotlight
        const spotlight = document.getElementById('pointer-spotlight');
        if (spotlight) {
          if (targetMode === 'matrix') {
            spotlight.style.display = 'none';
          } else {
            spotlight.style.display = '';
          }
        }

        updateModeUI(targetMode);
      }

      (window as any).applyFunMode = applyFunMode;
      (window as any).stopActiveToy = stopActiveToy;

      function initActiveFunMode() {
        let savedBg = 'spotlight';
        try {
          savedBg = localStorage.getItem('scushi_fun_mode') || 'spotlight';
        } catch (_) {}
        applyFunMode(savedBg, false);

        // Check if an interactive toy was persistent across routes
        let savedToy: string | null = null;
        try {
          savedToy = sessionStorage.getItem('scushi_active_toy');
        } catch (_) {}
        if (savedToy && TOY_CONFIGS[savedToy]) {
          launchToy(savedToy, false);
        }
      }

      initActiveFunMode();
      document.addEventListener('astro:page-load', initActiveFunMode);

      // Swarm Rebuild Loader & Triggers (only when explicitly requested)
      function triggerSwarmRebuild() {
        if ((window as any).__swarmRebuild) {
          (window as any).__swarmRebuild.toggle();
        } else {
          (window as any).__swarmAutoStart = true;
          const existing = document.getElementById('swarm-rebuild-script');
          if (!existing) {
            const script = document.createElement('script');
            script.src = '/swarm.js?v=3';
            script.id = 'swarm-rebuild-script';
            document.body.appendChild(script);
          }
        }
      }

      (window as any).triggerSwarmRebuild = triggerSwarmRebuild;

      // Universal keyboard shortcuts: [h], [p], [s], [b]
      window.addEventListener('keydown', (e) => {
        if (['INPUT', 'TEXTAREA'].includes((e.target as HTMLElement)?.tagName)) return;
        if (e.metaKey || e.ctrlKey || e.altKey) return;

        // If an interactive game or toy is active, DO NOT navigate away on 's' / 'h' / 'p'
        if (activeToy && ['asteroids', 'katamari'].includes(activeToy)) return;

        const key = e.key.toLowerCase();
        const currentPath = window.location.pathname.replace(/\/$/, '') || '/';

        if (key === 'h') {
          e.preventDefault();
          if (currentPath === '/' || currentPath === '') {
            window.scrollTo({ top: 0, behavior: 'smooth' });
          } else {
            navigate('/');
          }
        } else if (key === 'p') {
          e.preventDefault();
          if (currentPath === '/projects') {
            window.scrollTo({ top: 0, behavior: 'smooth' });
          } else {
            navigate('/projects/');
          }
        } else if (key === 's') {
          e.preventDefault();
          if (currentPath === '/systems') {
            window.scrollTo({ top: 0, behavior: 'smooth' });
          } else {
            navigate('/systems/');
          }
        } else if (key === 'b') {
          e.preventDefault();
          triggerSwarmRebuild();
        }
      });
    </script>
  </body>
</html>
